# Copy to .env and fill in the DSN. Everything else has a safe default.
#
# The DSN password is not repeated here on purpose: put it in .env, which
# .gitignore excludes.

ECI_PG_DSN=postgresql://eci_app:YOUR_PASSWORD_HERE@129.225.75.85:5432/old_eci
ECI_PG_SCHEMA=public

# This machine's identity in the fleet. Distinct from the Python/Android tags.
ECI_DEVICE_TAG=eci-node-desktop

# Throughput. There is no req/s constant: AIMD discovers the ceiling at runtime.
ECI_START_INFLIGHT=8
ECI_MAX_INFLIGHT=0
ECI_AIMD_WINDOW_MS=2000

# Sweeping
ECI_HTTP_TIMEOUT_MS=30000
ECI_BATCH_SIZE=200
ECI_SERIAL_STOP_AFTER=25
ECI_SERIAL_CAP=3000

# Fleet coordination (reservation queue + stale reaper)
ECI_RESERVE_N=5
ECI_RESERVE_TTL=900
ECI_STALE_MIN=30

# EPIC search (national display answers at about 1 req/s)
ECI_EPIC_MIN_INTERVAL_MS=1100
ECI_APP_KEYS=./app_keys.json

# ---- catalog admin panel (http://<host>:<port>/admin) ----
# Discovery probes part numbers upward in chunks; probing continues while the top
# of each chunk answers. The configured floor is a FLOOR, not a limit.
ECI_DISCOVER_CHUNK=200
ECI_DISCOVER_HARD_CAP=3000
ECI_DISCOVER_CONCURRENCY=8
ECI_DISCOVER_STALE_MIN=30

# Legacy catalogue DB (states / ACs) used by the seed actions. Defaults to the
# `eci` database on the same server as ECI_PG_DSN - set it only to override.
# ECI_GEO_DSN=postgresql://eci_app:PASSWORD@129.225.75.85:5432/eci

# ---- shared exact counters (stats.js) ----
# count(*) from electors and count(distinct cur_epic) are full scans of the whole
# table. ONE process at a time refreshes them and publishes the value to a shared
# settings row; every dashboard reads that row, so all instances agree.
# 4 instances each scanning every 120s is what saturated the database box.
ECI_STATS_TTL_MS=300000
ECI_STATS_LEASE_SEC=900
ECI_STATS_TIMEOUT_MS=600000
# 0 = this instance never runs the scan, it only reads the published value.
ECI_STATS_REFRESH=1

# ---- fleet health ----
# One settings row per device every 15s: AIMD limit, 429/5xx mix, current part,
# parts done, plus the egress IP hourly (the number that says whether two devices
# are competing for one per-IP gateway ceiling).
ECI_HEARTBEAT_MS=15000
ECI_REPORT_IP=1
ECI_FLEET_TTL_MS=15000
ECI_DB_HEALTH_TTL_MS=10000
